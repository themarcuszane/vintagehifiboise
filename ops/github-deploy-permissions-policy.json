{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSiteBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::vintagehifiboise.com"
    },
    {
      "Sid": "ReadAndWriteSiteObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::vintagehifiboise.com/*"
    },
    {
      "Sid": "RefreshSiteCache",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::502882675592:distribution/E16O0KIL2XTJRC"
    }
  ]
}
